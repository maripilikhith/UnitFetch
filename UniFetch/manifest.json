{
  "manifest_version": 3,
  "name": "UniFetch",
  "version": "3.0.0",
  "description": "Detect YouTube videos and download supported video + audio entirely in Chrome. No helper installation.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "sidePanel",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "UniFetch",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval'; connect-src 'none'; img-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none';"
  },
  "key": "",
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*",
    "https://youtu.be/*",
    "https://*.googlevideo.com/*",
    "https://youtubei.googleapis.com/*"
  ],
  "side_panel": {
    "default_path": "popup/popup.html?surface=panel"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*",
        "https://youtu.be/*"
      ],
      "js": [
        "content/youtube-launcher.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "sandbox": {
    "pages": [
      "engine/sandbox.html"
    ]
  }
}
