{
  "name": "unifetch-workspace",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test UniFetch/tests/*.test.js",
    "test:helper": "python -m unittest discover -s helper/tests -v",
    "test:browser": "node scripts/browser-test.cjs",
    "test:ui": "node scripts/v2-ui-test.cjs",
    "test:upgrade": "node scripts/upgrade-test.cjs",
    "test:youtube": "node scripts/youtube-ui-test.cjs",
    "fixture": "python scripts/generate-fixture.py",
    "check": "node scripts/validate.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "package": "node scripts/package-extension.mjs",
    "test:engine": "node scripts/engine-browser-test.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "googlevideo": "5.0.1",
    "mediabunny": "1.66.2",
    "playwright": "1.62.1",
    "youtubei.js": "18.3.0"
  }
}
